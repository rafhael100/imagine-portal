# F138 SAMPLE ONLY — do not start a service using placeholder values.
# Copy privately to .env.staging OUTSIDE source control on an approved VPS.
APP_NAME="Imagine Portal Staging"
APP_ENV=staging
APP_DEBUG=false
APP_URL=https://REPLACE_WITH_APPROVED_STAGING_HOST
APP_KEY=REPLACE_WITH_32_BYTE_BASE64_LARAVEL_APP_KEY

PORTAL_STAGING_LOOPBACK_PORT=18081
PORTAL_STAGING_DB=imagine_portal_staging
PORTAL_STAGING_DB_OWNER=portal_stage_owner
PORTAL_STAGING_DB_OWNER_PASSWORD=REPLACE_WITH_LONG_PRIVATE_OWNER_SECRET
PORTAL_APP_DB_USER=portal_stage_runtime
PORTAL_APP_DB_PASSWORD=REPLACE_WITH_LONG_PRIVATE_RUNTIME_SECRET

LOG_CHANNEL=stderr
LOG_LEVEL=warning
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=imagine_portal_staging_session
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=array

# Both remain false until staging approval and operator provisioning.
PORTAL_ADMIN_AUTH_ENABLED=false
PORTAL_ADMIN_PROVISION_ENABLED=false
