  "name": "imagine-portal-r03-c02-local-only",
  "main": "./src/worker.mjs",
  "compatibility_date": "2026-11-09",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "triggers": { "crons": [] },
  "durable_objects": {
    "bindings": [
      { "name": "FENCE_LAB", "class_name": "SyntheticFence" }
    ]
  },
  "exports": {
    "SyntheticFence": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
