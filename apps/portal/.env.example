APP_NAME="Imagine Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# EXCLUSIVAMENTE PLACEHOLDERS. NENHUM BANCO E PROVISIONADO.
# Nunca utilizar credenciais ou banco do Imagine CRM.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=imagine_portal_dev_placeholder
DB_USERNAME=portal_dev_placeholder
DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
# Synthetic mail is discarded in memory by default; do not log bearer tokens.
# Real SMTP delivery requires separate security review and approved secrets.
MAIL_MAILER=array
FILESYSTEM_DISK=local
