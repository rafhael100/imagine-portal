# Copie para .env no servidor; não envie segredos no chat nem os publique.
NODE_ENV=development
HOST=127.0.0.1
PORT=4173
APP_URL=http://127.0.0.1:4173
# Diretório persistente FORA da raiz pública; backup obrigatório no servidor.
DATA_DIR=./var
ASAAS_ENV=sandbox
ASAAS_API_KEY=
# Token aleatório próprio, de 32 a 255 caracteres, diferente da chave de API.
ASAAS_WEBHOOK_TOKEN=
# Em produção, use HTTPS no APP_URL e configure estes dois campos para liberar vendas.
SELLER_LEGAL_NAME=
SELLER_DOCUMENT=
# Administrador: usados SOMENTE pelo comando npm run admin.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Recuperação assistida: usados SOMENTE por npm run reset-password.
RESET_EMAIL=
RESET_PASSWORD=
