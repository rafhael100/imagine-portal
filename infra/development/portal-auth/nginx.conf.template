worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 128; }
http {
    access_log off;
    client_body_temp_path /tmp/client_body;
    fastcgi_temp_path /tmp/fastcgi;
    client_max_body_size 4k;
    client_body_buffer_size 8k;
    server {
        listen 8080;
        server_name portal-dev.imaginecomunica.com.br;
        if ($host != portal-dev.imaginecomunica.com.br) { return 444; }
        add_header Cache-Control "no-store, private" always;
        location = /up {
            limit_except GET HEAD { deny all; }
            include /etc/nginx/fastcgi_params;
            fastcgi_param SCRIPT_FILENAME /var/www/html/public/index.php;
            fastcgi_param HTTPS on;
            fastcgi_param SERVER_PORT 443;
            fastcgi_pass ${PORTAL_DB_CONTAINER}:9000;
        }
        location ~ ^/_development/auth/(csrf|session)$ {
            limit_except GET { deny all; }
            include /etc/nginx/fastcgi_params;
            fastcgi_param SCRIPT_FILENAME /var/www/html/public/index.php;
            fastcgi_param HTTPS on;
            fastcgi_param SERVER_PORT 443;
            fastcgi_pass ${PORTAL_DB_CONTAINER}:9000;
        }
        location ~ ^/_development/auth/(password|mfa|logout)$ {
            limit_except POST { deny all; }
            include /etc/nginx/fastcgi_params;
            fastcgi_param SCRIPT_FILENAME /var/www/html/public/index.php;
            fastcgi_param HTTPS on;
            fastcgi_param SERVER_PORT 443;
            fastcgi_pass ${PORTAL_DB_CONTAINER}:9000;
        }
        location / { return 404; }
    }
}
