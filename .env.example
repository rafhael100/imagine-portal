# Copie para .env no servidor; não envie segredos no chat nem os publique.
NODE_ENV=development
HOST=127.0.0.1
PORT=4173
APP_URL=http://127.0.0.1:4173
# Diretório persistente FORA da raiz pública; backup obrigatório no servidor.
DATA_DIR=./var
ASAAS_ENV=sandbox
ASAAS_API_KEY=
# Token aleatório próprio, de 32 a 255 caracteres, diferente da chave de API.
ASAAS_WEBHOOK_TOKEN=
# Em produção, use HTTPS no APP_URL e configure estes dois campos para liberar vendas.
SELLER_LEGAL_NAME=
SELLER_DOCUMENT=
# Administrador: usados SOMENTE pelo comando npm run admin.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Recuperação assistida: usados SOMENTE por npm run reset-password.
RESET_EMAIL=
RESET_PASSWORD=
# Focus NFe: tokens ficam somente no servidor; homologação por padrão.
FOCUS_ENV=homologacao
FOCUS_API_TOKEN=
# Segredo próprio, diferente do token API; mínimo de 32 caracteres.
FOCUS_WEBHOOK_TOKEN=
# Só liberar depois da validação fiscal e testes em homologação.
FOCUS_PRODUCTION_ENABLED=false
# E-mail de cobranças. TLS obrigatório: 465 implícito ou 587 STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Chave AES de 32 bytes (64 caracteres hexadecimais), gerada no servidor. Não compartilhar.
BILLING_TOKEN_KEY=
# true somente com proxy local que sobrescreve X-Forwarded-For.
APP_TRUST_PROXY=false
