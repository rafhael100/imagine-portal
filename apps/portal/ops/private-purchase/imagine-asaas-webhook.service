[Unit]
Description=Imagine authenticated Asaas sandbox event inbox
After=docker.service
Requires=docker.service
[Service]
Type=simple
WorkingDirectory=/srv/imagine/purchase-preview/apps/portal/ops/private-purchase
ExecStart=/usr/bin/python3 /srv/imagine/purchase-preview/apps/portal/ops/private-purchase/asaas_sandbox_webhook.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
[Install]
WantedBy=multi-user.target
